<!-- These resources are around just to allow their values to be customized
     for different hardware and product builds. -->
<resources>

    <!-- This device is not "voice capable"; it's data-only. -->
    <bool name="config_voice_capable">false</bool>

    <!-- This device does not allow sms service. -->
    <bool name="config_sms_capable">false</bool>

    <!-- Enable the software navigation bar, including gesture navigation and its mode picker. -->
    <bool name="config_showNavigationBar">true</bool>
    <!-- Start in gesture mode; Settings and SetupWizard can switch navigation modes. -->
    <integer name="config_navBarInteractionMode">2</integer>

    <!-- Sleep when the keyboard/display lid is closed and wake when it is opened. -->
    <bool name="config_lidControlsSleep">true</bool>

    <!-- Integer indicating the framework scan interval in milliseconds. -->
    <integer translatable="false" name="config_wifi_framework_scan_interval">10000</integer>

    <!-- XXXXX NOTE THE FOLLOWING RESOURCES USE THE WRONG NAMING CONVENTION.
         Please don't copy them, copy anything else. -->

    <!-- the 5th element "resore-time" indicates the number of milliseconds to delay
        before automatically restore the default connection.  Set -1 if the connection
         does not require auto-restore. -->
    <!-- the 6th element indicates boot-time dependency-met value. -->
    <string-array translatable="false" name="networkAttributes">
        <item>"wifi,1,1,1,-1,true"</item>
        <item>"ethernet,9,9,2,-1,true"</item>
    </string-array>

    <!-- This string array should be overridden by the device to present a list of radio
         attributes.  This is used by the connectivity manager to decide which networks can coexist
         based on the hardware -->
    <!-- An Array of "[ConnectivityManager connectionType],
                      [# simultaneous connection types]"  -->
    <string-array translatable="false" name="radioAttributes">
        <item>"1,1"</item>
        <item>"9,1"</item>
    </string-array>

    <!-- List of regexpressions describing the interface (if any) that represent tetherable
         Wifi interfaces.  If the device doesn't want to support tethering over Wifi this
         should be empty.  An example would be "softap.*" -->
    <string-array translatable="false" name="config_tether_wifi_regexs">
        <item>"wlan0"</item>
        <item>"softap.*"</item>
    </string-array>

   <!-- List of regexpressions describing the interface (if any) that represent tetherable
         bluetooth interfaces.  If the device doesn't want to support tethering over bluetooth this
         should be empty. -->
    <string-array translatable="false" name="config_tether_bluetooth_regexs">
        <item>"bt-pan"</item>
    </string-array>

    <!-- Array of allowable ConnectivityManager network types for tethering -->
    <!-- Common options are [1, 4] for TYPE_WIFI and TYPE_MOBILE_DUN or
         [0,1,5,7] for TYPE_MOBILE, TYPE_WIFI, TYPE_MOBILE_HIPRI and TYPE_BLUETOOTH -->
    <integer-array translatable="false" name="config_tether_upstream_types">
        <item>1</item>
        <item>7</item>
    </integer-array>

    <!-- Enable Desktop Mode on external DisplayPort displays -->
    <bool name="config_isDesktopModeSupported">true</bool>

    <!-- ============================================================ -->
    <!-- Doze / Deep Idle fix: trogdor has no Significant Motion      -->
    <!-- Detector (cros-ec-accel does not expose an SMD interrupt), so -->
    <!-- Android stays in Light Doze forever by default.              -->
    <!-- config_autoPowerModeAnyMotionSensor is omitted: its default  -->
    <!-- is 0 (integer), which already means "no specific sensor",    -->
    <!-- producing the same mMotionSensor=null result we need.        -->
    <!-- ============================================================ -->

    <!-- Enter deep doze immediately after the screen turns off instead
         of waiting for the "stationary" sensing window to expire.
         Default upstream value is false; must be true here.          -->
    <bool name="config_dozeAfterScreenOffByDefault">true</bool>

</resources>

+static std::string ReadMiscCommand() {
+    int fd = open("/dev/block/by-name/misc", O_RDONLY | O_CLOEXEC);
+    if (fd == -1) return "";
+    char command[32] = {};
+    ssize_t size = read(fd, command, sizeof(command));
+    close(fd);
+    if (size != sizeof(command)) return "";
+    return std::string(command, strnlen(command, sizeof(command)));
+}
+
+static std::string ReadSysFile(const std::string& path) {
+    std::string value;
+    android::base::ReadFileToString(path, &value);
+    return value;
+}
+
+static std::string UeventField(const std::string& uevent, const std::string& key) {
+    for (const auto& line : android::base::Split(uevent, "\n")) {
+        if (android::base::StartsWith(line, key + "=")) {
+            return line.substr(key.size() + 1);
+        }
+    }
+    return "";
+}
+
+static void SetupByNames(const std::string& cmdline) {
+    static constexpr const char kBootUuid[] = "androidboot.boot_part_uuid=";
+    auto pos = cmdline.find(kBootUuid);
+    if (pos == std::string::npos) return;
+    auto end = cmdline.find(' ', pos);
+    std::string uuid = cmdline.substr(pos + strlen(kBootUuid),
+                                      end == std::string::npos ? std::string::npos : end - pos - strlen(kBootUuid));
+    if (uuid.empty()) return;
+
+    std::string boot_dev;
+    for (int attempt = 0; attempt < 50 && boot_dev.empty(); ++attempt) {
+        std::error_code ec;
+        for (fs::directory_iterator it("/sys/class/block", ec), last; !ec && it != last;
+             it.increment(ec)) {
+            auto uevent = ReadSysFile((it->path() / "uevent").string());
+            if (UeventField(uevent, "PARTUUID") == uuid) {
+                boot_dev = UeventField(uevent, "DEVNAME");
+                break;
+            }
+        }
+        if (boot_dev.empty()) usleep(100000);
+    }
+    if (boot_dev.empty()) return;
+
+    std::error_code ec;
+
+    auto boot_path = fs::canonical(fs::path("/sys/class/block") / boot_dev, ec);
+    if (ec) return;
+    std::string disk = boot_path.parent_path().filename().string();
+    if (disk.empty()) return;
+
+    mkdir("/dev/block", 0755);
+    mkdir("/dev/block/by-name", 0755);
+
+    for (fs::directory_iterator it("/sys/class/block", ec), last; !ec && it != last; it.increment(ec)) {
+        auto part_path = fs::canonical(it->path(), ec);
+        if (ec) {
+            ec.clear();
+            continue;
+        }
+        if (part_path.parent_path().filename() != disk) continue;
+
+        auto uevent = ReadSysFile((it->path() / "uevent").string());
+        auto name = UeventField(uevent, "PARTNAME");
+        auto dev = UeventField(uevent, "DEVNAME");
+        if (name.empty() || dev.empty()) continue;
+
+        std::string devnode = "/dev/block/" + dev;
+        struct stat st {};
+        if (stat(devnode.c_str(), &st) != 0) {
+            auto devnum = ReadSysFile((it->path() / "dev").string());
+            unsigned int major = 0, minor = 0;
+            if (sscanf(devnum.c_str(), "%u:%u", &major, &minor) == 2) {
+                mknod(devnode.c_str(), S_IFBLK | 0600, makedev(major, minor));
+            }
+        }
+
+        std::string link = "/dev/block/by-name/" + name;
+        unlink(link.c_str());
+        symlink(devnode.c_str(), link.c_str());
+    }
+}

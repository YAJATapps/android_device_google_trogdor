+/*
+ * Devices with a quad-channel speaker arrangement driven by a single PCM
+ * (e.g. the four MAX98360A amplifiers on trogdor homestar) expect the quad
+ * stream as [L, L, R, R] (top-left, bottom-left, top-right, bottom-right),
+ * while AudioFlinger delivers [L, R, x, x]. Expand each stereo pair in place
+ * before it reaches the PCM. Applies to S16 quad streams only, and only when
+ * the device enables vendor.audio.tinyalsa.quad_speaker_compat at boot.
+ */
+static bool proxy_needs_quad_remap(const alsa_device_proxy * proxy)
+{
+    return proxy->alsa_config.channels == 4 &&
+           proxy->alsa_config.format == PCM_FORMAT_S16_LE &&
+           property_get_bool("vendor.audio.tinyalsa.quad_speaker_compat", false);
+}
+
+static void remap_quad_stereo_in_place(void * data, unsigned int count)
+{
+    int16_t * frames = (int16_t *)data;
+    const unsigned int frame_count = count / (4 * sizeof(int16_t));
+    for (unsigned int i = 0; i < frame_count; ++i) {
+        const int16_t left = frames[4 * i];
+        const int16_t right = frames[4 * i + 1];
+        frames[4 * i + 1] = left;
+        frames[4 * i + 2] = right;
+        frames[4 * i + 3] = right;
+    }
+}
+
 int proxy_write_with_retries(
         alsa_device_proxy * proxy, const void *data, unsigned int count, int tries)
 {
+    // Remap before the retry loop so a retried write is not remapped twice.
+    if (proxy_needs_quad_remap(proxy)) {
+        remap_quad_stereo_in_place((void *)(uintptr_t)data, count);
+    }
     while (true) {
         --tries;
         const int ret = pcm_write(proxy->pcm, data, count);

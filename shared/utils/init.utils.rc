service set_hw /vendor/bin/set_hw.sh
    class core
    user root
    group system
    disabled
    oneshot

service qrtr-ns /vendor/bin/qrtr-ns -f 1
    class core
    user root
    group system
    disabled
    oneshot

service vendor.tqftpserv /vendor/bin/tqftpserv
    class core
    user root
    group system
    stdio_to_kmsg
    disabled

service vendor.efs-loader /vendor/bin/efs-loader
    class core
    user root
    group system
    stdio_to_kmsg
    disabled
    oneshot

service vendor.rmtfs /vendor/bin/rmtfs -r -s -o /data/vendor/rmtfs
    class core
    user root
    group system
    stdio_to_kmsg
    disabled

on early-init
    exec_start set_hw
    exec - root -- /vendor/bin/qrtr-cfg 1
    start qrtr-ns

on init
    mkdir /dev/block/bootdevice 0775 root system
    symlink /dev/block/by-name /dev/block/bootdevice/by-name

on post-fs-data
    mkdir /data/vendor 0771 root system
    mkdir /data/vendor/rmtfs 0770 root system
    restorecon_recursive /data/vendor/rmtfs
    mkdir /data/vendor/tmp 0771 root system
    mkdir /data/vendor/readwrite 0771 root system
    mkdir /data/vendor/readonly 0771 root system
    mkdir /data/vendor/readonly/firmware 0771 root system
    mkdir /data/vendor/readonly/firmware/image 0771 root system
    write /sys/class/firmware/timeout 1
    start vendor.tqftpserv
    exec_start vendor.efs-loader
    start vendor.rmtfs

on shutdown
    stop vendor.rmtfs

service set_hw /vendor/bin/set_hw.sh
    class core
    user root
    group system
    disabled
    oneshot

service qrtr-ns /vendor/bin/qrtr-ns -f 1
    class core
    user root
    group system
    disabled
    oneshot

service vendor.tqftpserv /vendor/bin/tqftpserv
    class core
    user root
    group system
    stdio_to_kmsg
    disabled

service vendor.rmtfs /vendor/bin/rmtfs -o /dev/block/by-name -P -r -s
    class core
    user root
    group system
    stdio_to_kmsg
    disabled

on early-init
    start set_hw
    exec - root -- /vendor/bin/qrtr-cfg 1
    start qrtr-ns

on init
    mkdir /dev/block/bootdevice 0775 root system
    symlink /dev/block/by-name /dev/block/bootdevice/by-name

on post-fs && property:vendor.hw=trogdor
    exec - root -- /system/bin/sleep 1
    exec - system audio -- /system/bin/tinymix "QUAT_MI2S_RX Audio Mixer MultiMedia1" 1

on post-fs && property:vendor.hw=rb5
    exec - root -- /system/bin/sleep 1
    exec - system audio -- /system/bin/tinymix "TERT_MI2S_RX Audio Mixer MultiMedia1" 1

on post-fs && property:vendor.hw=sm8550hdk
    exec - root -- /system/bin/sleep 1
    exec - system audio -- /system/bin/tinymix "SpkrLeft PA Volume" "15"
    exec - system audio -- /system/bin/tinymix "SpkrRight PA Volume" "15"
    exec - system audio -- /system/bin/tinymix "WSA RX0 MUX" "AIF1_PB"
    exec - system audio -- /system/bin/tinymix "WSA RX1 MUX" "AIF1_PB"
    exec - system audio -- /system/bin/tinymix "WSA_RX0 INP0" "RX0"
    exec - system audio -- /system/bin/tinymix "WSA_RX1 INP0" "RX1"
    exec - system audio -- /system/bin/tinymix "SpkrLeft DAC Switch" "1"
    exec - system audio -- /system/bin/tinymix "SpkrRight DAC Switch" "1"
    exec - system audio -- /system/bin/tinymix "WSA_RX0 Digital Volume" "85"
    exec - system audio -- /system/bin/tinymix "WSA_RX1 Digital Volume" "85"
    exec - system audio -- /system/bin/tinymix "WSA_CODEC_DMA_RX_0 Audio Mixer MultiMedia1" "1"

on post-fs-data
    mkdir /data/vendor 0771 root system
    mkdir /data/vendor/tmp 0771 root system
    mkdir /data/vendor/readwrite 0771 root system
    mkdir /data/vendor/readonly 0771 root system
    mkdir /data/vendor/readonly/firmware 0771 root system
    mkdir /data/vendor/readonly/firmware/image 0771 root system
    write /sys/class/firmware/timeout 1
    start vendor.tqftpserv
    start vendor.rmtfs

on shutdown
    stop vendor.rmtfs
